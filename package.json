{
  "name": "vite-plugin-unused-code",
  "version": "0.1.8",
  "description": "Vite/Rollup plugin to detect unused files and unused exports in used files",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint --fix './**/*.{js,ts}'",
    "lint:ci": "eslint --max-warnings 0 './**/*.{js,ts}'",
    "prepack": "tsdown",
    "release": "release-it",
    "test": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyanSalt/vite-plugin-unused-code.git"
  },
  "keywords": [
    "vite",
    "rollup",
    "deadcode",
    "unused"
  ],
  "author": "CyanSalt",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/CyanSalt/vite-plugin-unused-code/issues"
  },
  "homepage": "https://github.com/CyanSalt/vite-plugin-unused-code#readme",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "error"
    },
    "packageManager": [
      {
        "name": "pnpm",
        "version": "^11.0.0",
        "onFail": "error"
      },
      {
        "name": "npm",
        "onFail": "ignore"
      }
    ]
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "micromatch": "^4.0.8"
  },
  "devDependencies": {
    "@cyansalt/eslint-config": "^4.6.0",
    "@cyansalt/tsconfig": "^3.0.2",
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^24.12.3",
    "eslint": "^10.3.0",
    "release-it": "^20.0.1",
    "rolldown": "1.0.0",
    "rolldown-vite": "^7.3.1",
    "rollup": "^4.60.3",
    "tsdown": "^0.22.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "vite": ">=2.0.0"
  }
}
